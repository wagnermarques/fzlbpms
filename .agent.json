{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "agent-safe-commands-configuration",
  "version": "1.0.0",
  "description": "Auto-approval configuration for safe, read-only bash commands and GitHub curl operations",
  "permissions": {
    "auto_approve": true,
    "allowed_domains": [
      "github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "gist.githubusercontent.com",
      "objects.githubusercontent.com"
    ],
    "allowed_command_prefixes": [
      "ls",
      "dir",
      "tree",
      "head",
      "tail",
      "cat",
      "less",
      "more",
      "nl",
      "grep",
      "egrep",
      "fgrep",
      "rg",
      "ag",
      "find",
      "fd",
      "which",
      "whereis",
      "type",
      "command -v",
      "pwd",
      "stat",
      "file",
      "wc",
      "diff",
      "cmp",
      "md5sum",
      "sha256sum",
      "sha1sum",
      "jq",
      "yq",
      "sort",
      "uniq",
      "cut",
      "tr",
      "column",
      "awk",
      "echo",
      "printf",
      "date",
      "uptime",
      "whoami",
      "id",
      "uname",
      "env",
      "printenv",
      "git status",
      "git log",
      "git diff",
      "git show",
      "git branch",
      "git tag",
      "git rev-parse",
      "git remote",
      "git describe",
      "git config --get",
      "git config --list",
      "gh repo view",
      "gh issue list",
      "gh issue view",
      "gh pr list",
      "gh pr view",
      "gh run list",
      "gh run view",
      "gh api",
      "python3 --version",
      "python3 -m json.tool",
      "node --version",
      "node -v",
      "npm --version",
      "npm -v",
      "docker compose ps",
      "docker ps"
    ],
    "allowed_command_patterns": [
      "^ls(\\s+.*)?$",
      "^dir(\\s+.*)?$",
      "^tree(\\s+.*)?$",
      "^head(\\s+.*)?$",
      "^tail(\\s+.*)?$",
      "^cat(\\s+.*)?$",
      "^less(\\s+.*)?$",
      "^grep(\\s+.*)?$",
      "^egrep(\\s+.*)?$",
      "^rg(\\s+.*)?$",
      "^find(\\s+.*)?$",
      "^fd(\\s+.*)?$",
      "^pwd$",
      "^stat(\\s+.*)?$",
      "^file(\\s+.*)?$",
      "^wc(\\s+.*)?$",
      "^diff(\\s+.*)?$",
      "^echo(\\s+.*)?$",
      "^printf(\\s+.*)?$",
      "^which(\\s+.*)?$",
      "^command\\s+-v(\\s+.*)?$",
      "^type(\\s+.*)?$",
      "^jq(\\s+.*)?$",
      "^sort(\\s+.*)?$",
      "^uniq(\\s+.*)?$",
      "^cut(\\s+.*)?$",
      "^tr(\\s+.*)?$",
      "^awk(\\s+.*)?$",
      "^git\\s+(status|log|diff|show|branch|tag|rev-parse|remote|describe)(\\s+.*)?$",
      "^gh\\s+(repo\\s+view|issue\\s+list|issue\\s+view|pr\\s+list|pr\\s+view|run\\s+list|run\\s+view|api)(\\s+.*)?$",
      "^curl(\\s+.*)?https?:\\/\\/([a-zA-Z0-9.-]+\\.)?(github\\.com|githubusercontent\\.com)(\\/.*)?$",
      "^wget(\\s+.*)?https?:\\/\\/([a-zA-Z0-9.-]+\\.)?(github\\.com|githubusercontent\\.com)(\\/.*)?$"
    ]
  }
}
