# Local environment — gitignored. Single source of truth for ports/secrets.
# Generated from .env.template on 2026-07-19, keeping the values that were
# previously hard-coded in docker-compose.yml so existing data volumes
# (mysql-data, postgresql-data, keycloak postgres-data, flowable_db_data)
# keep working. Change a DB password here only if you also change it in the
# already-initialized database.

FZL_HOME=/run/media/wgn/ext4/Projects-Srcs/Projects-Srcs-FzlSoft/fzlbpms

FZLBPMS_ADMIN_USERNAME=fzlbpmsadmin
FZLBPMS_ADMIN_PASSWORD=Admin@fzlbpms1

# --- nginx ------------------------------------------------------------------
FZL_NGINX_PORT_HTTP=80
FZL_NGINX_PORT_HTTPS=443

# --- MySQL (+ phpMyAdmin) ---------------------------------------------------
FZL_MYSQL_PORT=3316
FZL_MYSQL_ROOT_PASSWORD=1234
FZL_MYSQL_DATABASE=fzl_db
FZL_MYSQL_USER=fzl_user
FZL_MYSQL_PASSWORD=1234
FZL_PHPMYADMIN_PORT=8889

# --- PostgreSQL (main db) ---------------------------------------------------
FZL_POSTGRES_PORT=5432
FZL_POSTGRES_USER=postgres
FZL_POSTGRES_PASSWORD=1234
FZL_POSTGRES_DB=fzldb

# --- Moodle -----------------------------------------------------------------
# Auto-provisioned by the `moodle-installer` service on `run-stack.sh basic`.
# MOODLE_VERSION must be a real download.moodle.org stable release.
MOODLE_VERSION=5.2.1
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASS=moodlepassword
MOODLE_WWWROOT=https://fzlbpms.com.br/moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=Admin@moodle1
MOODLE_ADMIN_EMAIL=wagnerdocri@gmail.com
MOODLE_FULLNAME=fzlbpms Moodle
MOODLE_SHORTNAME=fzlbpms

# --- Contatemeantes (GPS tracking bundle, own DB in fzl-postgresql) --------
CONTATEMEANTES_DB_NAME=contatemeantes
CONTATEMEANTES_DB_USER=contatemeantes
CONTATEMEANTES_DB_PASS=TwdjiZVokwGb7bYEiJuWm6Fr

# Promoted to Moodle site administrator via SSO (see
# bin/moodle/configure-oauth2-keycloak.php) instead of FZLBPMS_ADMIN_USERNAME.
# Separate from MOODLE_ADMIN_USER/PASS above, which is Moodle's own local
# (non-SSO) admin account created at install time.
FZL_MOODLE_ADMIN_USERNAME=moodle-admin
FZL_MOODLE_ADMIN_PASSWORD=Admin@fzlbpms1-moodle

# --- Moodle REST web services (consumed by the Camel moodle bundle) ---------
# Fixed 32-char token shared by moodle-webservice-configurator (which binds
# it to the fzlbpms_ws user+service in Moodle) and the Camel bundle (which
# sends it as wstoken). Internal service-to-service URL through nginx.
MOODLE_WS_TOKEN=f4a10ada9f72911b4b6ac7650658e8f7
MOODLE_WS_URL=https://fzlbpms.com.br/moodle/webservice/rest/server.php

# --- Nexus 3 ----------------------------------------------------------------
FZL_NEXUS_PORT_HTTP=8088
FZL_NEXUS_PORT_DOCKER=8082
# Consumed by containers/fzl-maven/settings.xml through the containerized
# `mvn` alias (ansible/commands-aliases.yml). This is the generated initial
# password (nexus-data/admin.password) — if you change it in the Nexus UI,
# update it here too.
FZL_NEXUS_ADMIN_USER=admin
FZL_NEXUS_ADMIN_PASSWORD=9ef1a0fe-5fb4-45f8-827b-e10b3266db3e

# --- Karaf / Camel ---------------------------------------------------------
FZL_KARAF_REST_PORT=9090
# Second Jetty port for the Moodle integration bundle (moodle-admin-camel-context.xml).
FZL_KARAF_MOODLE_REST_PORT=9091
# Client secret Camel uses to authenticate against Keycloak as fzlbpms-camel.
# Change this before any non-dev deployment.
FZL_CAMEL_CLIENT_SECRET=fzlbpmsCamelSecret01

# --- Keycloak ---------------------------------------------------------------
FZL_KEYCLOAK_PORT=8083
FZL_KEYCLOAK_ADMIN_USER=admin
FZL_KEYCLOAK_ADMIN_PASSWORD=admin
FZL_KEYCLOAK_DB_NAME=keycloak
FZL_KEYCLOAK_DB_USER=keycloak
FZL_KEYCLOAK_DB_PASSWORD=password

# Canonical externally-reachable hostname for Keycloak (KC_HOSTNAME) and for
# the OAuth2 redirect URIs registered on the fzlbpmsadmin-web/moodle clients.
FZL_PUBLIC_HOSTNAME=fzlbpms.com.br
# Scheme matching FZL_PUBLIC_HOSTNAME — kept in sync by bin/switch-domain.sh.
FZL_PUBLIC_PROTO=https

# Keycloak client used by fzlbpmsadmin-web's browser-redirect (Authorization
# Code + PKCE) login — public client, no secret.
FZL_WEBAPP_CLIENT_ID=fzlbpmsadmin-web

# Keycloak client used by Moodle's auth_oauth2 plugin for SSO.
FZL_MOODLE_CLIENT_ID=moodle
FZL_MOODLE_CLIENT_SECRET=3fe9f123c0cd7191c77d1e095ecaa75f

# Keycloak client used by Flowable UI's Spring Security OIDC login for SSO.
FZL_FLOWABLE_CLIENT_ID=flowable
FZL_FLOWABLE_CLIENT_SECRET=1934cf6ca904710af9cfb20840b620b6

# Keycloak client used by fzl-oauth2-proxy to gate the Theia IDE at /theia/.
FZL_THEIA_CLIENT_ID=theia
FZL_THEIA_CLIENT_SECRET=68e132f26236818f078e360e8e730fbd

# --- Theia (browser IDE at /theia/) -----------------------------------------
# Direct-access port, bypassing nginx and therefore bypassing SSO. Debug only.
FZL_THEIA_PORT=3000

# uid/gid the IDE runs as — must match the host user owning ./workspaces.
FZL_THEIA_UID=1000
FZL_THEIA_GID=1000

# Cookie signing key for fzl-oauth2-proxy (32 random bytes, base64url).
FZL_OAUTH2_COOKIE_SECRET=Hp9V32l_MHKkdL7Cx6eygjXzZ78yuTMVNiUvU4OTc6w=

# Tracks FZL_PUBLIC_PROTO=https above.
FZL_OAUTH2_COOKIE_SECURE=true

# --- Flowable ---------------------------------------------------------------
FZL_FLOWABLE_UI_PORT=8080
FZL_FLOWABLE_DB_PORT=5435
FZL_FLOWABLE_DB_NAME=flowable
FZL_FLOWABLE_DB_USER=flowable
FZL_FLOWABLE_DB_PASSWORD=flowablepassword

# Promoted to Flowable admin group so IDM/Flowable actually treat this user as
# an admin — every other realm user only gets 'access-task' by default (see
# fzl-flowable-ui's SPRING_APPLICATION_JSON in docker-compose.yml).
FZL_FLOWABLE_ADMIN_USERNAME=flowable-admin
FZL_FLOWABLE_ADMIN_PASSWORD=Admin@fzlbpms1-flowable

# --- BPMN drawer ------------------------------------------------------------
FZL_BPMN_DRAWER_PORT=8085

# --- GitLab CE --------------------------------------------------------------
FZL_GITLAB_PORT_HTTP=8086
FZL_GITLAB_PORT_SSH=2222
FZL_GITLAB_ROOT_PASSWORD=QueCh@t03skoLHER1S3NH4!

# --- MongoDB (overleaf) -----------------------------------------------------
FZL_MONGO_USER=overleaf
FZL_MONGO_PASSWORD=overleaf_pass
FZL_MONGO_DATABASE=overleaf

# --- Elasticsearch / Kibana -------------------------------------------------
FZL_ELASTICSEARCH_PORT=9200
FZL_KIBANA_PORT=5601

# --- Dev / management UIs ---------------------------------------------------
FZL_ANGULAR_DEV_PORT=4200
FZL_PORTAINER_PORT_HTTP=9000
FZL_PORTAINER_PORT_TLS=9043

# --- Superset (BI dashboards) ------------------------------------------------
FZL_SUPERSET_PORT=8087
FZL_SUPERSET_SECRET_KEY=5nlwqhAHYBm8SadgdYONx5ZIfyP/+jf5gfAh8YuELzh94Y8yIyEv1Kn7
FZL_SUPERSET_ADMIN_USER=admin
FZL_SUPERSET_ADMIN_PASSWORD=Admin@superset1
FZL_SUPERSET_ADMIN_EMAIL=wagnerdocri@gmail.com
FZL_SUPERSET_DB_PORT=5436
FZL_SUPERSET_DB_NAME=superset
FZL_SUPERSET_DB_USER=superset
FZL_SUPERSET_DB_PASSWORD=supersetpassword

# --- Fakemail (host network, ports bind directly on host) -------------------
FZL_FAKEMAIL_WEB_PORT=5080
FZL_FAKEMAIL_MGMT_PORT=5081
FZL_FAKEMAIL_SMTP_PORT=8025

# --- Orbeon Forms (open-source forms platform, Community Edition) ------------
# Visual Form Builder + Form Runner at https://fzlbpms.local/orbeon/.
FZL_ORBEON_PORT=8890
FZL_ORBEON_DB_NAME=orbeon
FZL_ORBEON_CRYPTO_PASSWORD=Orbeon@fzlbpms2026CryptoKey

# --- Cloudflare Tunnel (fzl-cloudflared -> exposes fzl-nginx publicly) ------
# Get from: one.dash.cloudflare.com -> Networks -> Tunnels -> fzlbpms-tunnel
# -> Configure -> the --token value in the docker run install command.
# REPLACE "changeme" before starting fzl-cloudflared — it will fail to
# connect with a placeholder value.
FZL_CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiYzc3ZTJhMGRiZjcyMDFmZjJhOWFmZWEwOTAwMGU0NTgiLCJ0IjoiNTFkYjdjYjMtZjA5Yi00MzViLWJlNzYtZTY3M2Y1ODljM2U3IiwicyI6IlJBRUJpMmhPRlMzT3ptNDZwcUJvRk9oRnh6b1Z6LzRMQVBDV0RnZlVZVVU9In0=

# --- Karaf admin tools (Felix web console + Hawtio) -------------------------
# Presented by nginx towards /system/console and /hawtio after Keycloak
# sign-in, so users never type it. Must match a user in the Karaf JAAS realm
# (containers/fzl-karaf-camel-integration/custom_karaf_etc/etc-from-4.4.7/
# users.properties). Change BOTH if you rotate it.
FZL_KARAF_USER=karaf
FZL_KARAF_PASSWORD=nvZePWefqBwSV7yqvNJwQ1NXFPzW
