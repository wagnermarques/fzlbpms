# ============================================================================
# fzlbpms environment — SINGLE SOURCE OF TRUTH for host ports and credentials.
#
# Usage:  cp .env.template .env   (then adjust values; .env is gitignored)
#
# docker-compose.yml reads this file automatically and fails with a clear
# error if a variable is missing. Only HOST-side ports live here; ports
# internal to the fzl-network stay hard-coded in docker-compose.yml.
#
# The Maven parent POM (src-projects/mvn-artifacts/fzlparent) mirrors
# FZL_NEXUS_PORT_HTTP via its <fzl.nexus.port> property — keep them in sync
# or override at build time: mvn deploy -Dfzl.nexus.port=<port>
# ============================================================================

FZL_HOME=/path/to/fzlbpms


FZLBPMS_ADMIN_USERNAME=fzlbpmsadmin
FZLBPMS_ADMIN_PASSWORD=Admin@fzlbpms1


# --- nginx (web entrypoint: moodle, yii2 apps, sites) -----------------------
FZL_NGINX_PORT_HTTP=80
# https://fzlbpms.local — local SSO testing (Moodle/Flowable need HTTPS).
# See bin/setup-local-https.sh / ansible/fzlbpms-setup.yml.
FZL_NGINX_PORT_HTTPS=443
FZL_NGINX_PORT_FZLBPMS_APPS=8899
FZL_NGINX_PORT_SITES=8900

# --- MySQL (+ phpMyAdmin) ---------------------------------------------------
FZL_MYSQL_PORT=3316
FZL_MYSQL_ROOT_PASSWORD=changeme
FZL_MYSQL_DATABASE=fzl_db
FZL_MYSQL_USER=fzl_user
FZL_MYSQL_PASSWORD=changeme
FZL_PHPMYADMIN_PORT=8889

# --- PostgreSQL (main db: moodle, apps) -------------------------------------
FZL_POSTGRES_PORT=5432
FZL_POSTGRES_USER=postgres
FZL_POSTGRES_PASSWORD=changeme
FZL_POSTGRES_DB=fzldb

# --- Moodle -----------------------------------------------------------------
# Auto-provisioned by the `moodle-installer` service on `run-stack.sh basic`.
# MOODLE_VERSION must be a real download.moodle.org stable release
# (e.g. 5.2.1). The installer derives the stable dir automatically.
MOODLE_VERSION=5.2.1
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASS=changeme
MOODLE_WWWROOT=http://localhost/moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=changeme
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_FULLNAME=fzlbpms Moodle
MOODLE_SHORTNAME=fzlbpms

# --- Moodle REST web services (consumed by the Camel moodle bundle) ---------
# Fixed token shared by moodle-webservice-configurator (binds it to the
# fzlbpms_ws user+service in Moodle) and the Camel moodle bundle (sends it as
# wstoken). Generate a fresh one with: openssl rand -hex 16
MOODLE_WS_TOKEN=changeme-32-hex-chars-openssl-rand
MOODLE_WS_URL=https://fzlbpms.local/moodle/webservice/rest/server.php

# --- Nexus 3 (maven artifact repository) ------------------------------------
# FZL_NEXUS_PORT_HTTP -> container 8081 (web UI + maven repos)
# FZL_NEXUS_PORT_DOCKER -> container 8082 (docker registry connector)
FZL_NEXUS_PORT_HTTP=8088
FZL_NEXUS_PORT_DOCKER=8082
# Admin credentials, consumed by containers/fzl-maven/settings.xml through the
# containerized `mvn` alias (ansible/commands-aliases.yml). On a fresh Nexus
# the password is generated — read it with:
#   docker exec fzl-nexus cat /nexus-data/admin.password
FZL_NEXUS_ADMIN_USER=admin
FZL_NEXUS_ADMIN_PASSWORD=change-me

# --- Karaf / Camel integration ----------------------------------------------
# Jetty port of the main Camel REST bundle -> container 9090.
FZL_KARAF_REST_PORT=9090
# Second Jetty port, for the Moodle integration bundle
# (src-projects/karaf_bundles/.../moodle-admin-camel-context.xml).
FZL_KARAF_MOODLE_REST_PORT=9091
# Client secret Camel uses to authenticate against Keycloak as fzlbpms-camel.
# Must match the secret of that client in the Keycloak realm.
FZL_CAMEL_CLIENT_SECRET=changeme

# --- Keycloak (SSO) ---------------------------------------------------------
FZL_KEYCLOAK_PORT=8083
FZL_KEYCLOAK_ADMIN_USER=admin
FZL_KEYCLOAK_ADMIN_PASSWORD=changeme
FZL_KEYCLOAK_DB_NAME=keycloak
FZL_KEYCLOAK_DB_USER=keycloak
FZL_KEYCLOAK_DB_PASSWORD=changeme

# Canonical externally-reachable hostname for Keycloak (KC_HOSTNAME) and for
# the OAuth2 redirect URIs registered on the fzlbpmsadmin-web/moodle clients.
# OIDC browser redirects need Keycloak to report ONE fixed hostname in every
# URL it generates — set this to your real public domain (e.g. the one your
# Cloudflare tunnel exposes) before enabling browser-redirect SSO login.
# Defaults to "localhost" for a LAN-only dev stack with no SSO redirect flow.
FZL_PUBLIC_HOSTNAME=localhost

# Scheme matching FZL_PUBLIC_HOSTNAME above — "http" for the bare "localhost"
# default (nginx has no TLS listener there), "https" for a real public domain.
# Used to build the OAuth2 issuer URLs Moodle/Flowable call directly (not
# through a browser), so it must be set correctly rather than assumed.
# bin/switch-domain.sh keeps this in sync with FZL_PUBLIC_HOSTNAME for you.
FZL_PUBLIC_PROTO=http

# Keycloak client used by fzlbpmsadmin-web's browser-redirect (Authorization
# Code + PKCE) login — public client, no secret.
FZL_WEBAPP_CLIENT_ID=fzlbpmsadmin-web

# Keycloak client used by Moodle's auth_oauth2 plugin for SSO.
FZL_MOODLE_CLIENT_ID=moodle
FZL_MOODLE_CLIENT_SECRET=changeme

# Keycloak client used by Flowable UI's Spring Security OIDC login for SSO.
FZL_FLOWABLE_CLIENT_ID=flowable
FZL_FLOWABLE_CLIENT_SECRET=changeme

# Keycloak client used by fzl-oauth2-proxy to gate the Theia IDE at /theia/.
FZL_THEIA_CLIENT_ID=theia
FZL_THEIA_CLIENT_SECRET=changeme

# --- Theia (browser IDE at /theia/) -----------------------------------------
# Direct-access port, bypassing nginx and therefore bypassing SSO. Debug only.
FZL_THEIA_PORT=3000

# uid/gid the IDE process runs as. MUST match the host user that owns
# ./workspaces (run `id -u` / `id -g`), otherwise the IDE can only write into
# world-writable directories and the files it creates are owned by the wrong
# user on the host. Changing these requires a rebuild:
#   docker compose build fzl-theia
FZL_THEIA_UID=1000
FZL_THEIA_GID=1000

# Cookie signing key for fzl-oauth2-proxy. MUST be 16, 24 or 32 bytes —
# generate with:  openssl rand -base64 32 | tr -- '+/' '-_'
FZL_OAUTH2_COOKIE_SECRET=changeme-generate-a-real-one

# Must track FZL_PUBLIC_PROTO above: "true" for https, "false" for plain-http
# localhost — a Secure cookie is never sent over http, so leaving this true
# on an http stack produces an endless redirect loop back to Keycloak.
# bin/switch-domain.sh keeps this in sync for you.
FZL_OAUTH2_COOKIE_SECURE=true

# --- Flowable (BPM engine) --------------------------------------------------
FZL_FLOWABLE_UI_PORT=8080
FZL_FLOWABLE_DB_PORT=5435
FZL_FLOWABLE_DB_NAME=flowable
FZL_FLOWABLE_DB_USER=flowable
FZL_FLOWABLE_DB_PASSWORD=changeme

# --- BPMN drawer ------------------------------------------------------------
FZL_BPMN_DRAWER_PORT=8085

# --- GitLab CE --------------------------------------------------------------
FZL_GITLAB_PORT_HTTP=8086
FZL_GITLAB_PORT_SSH=2222
# GitLab validates password strength: use letters+digits+symbols, min 8 chars
FZL_GITLAB_ROOT_PASSWORD=changeme

# --- MongoDB (overleaf) -----------------------------------------------------
FZL_MONGO_USER=overleaf
FZL_MONGO_PASSWORD=changeme
FZL_MONGO_DATABASE=overleaf

# --- Elasticsearch / Kibana -------------------------------------------------
FZL_ELASTICSEARCH_PORT=9200
FZL_KIBANA_PORT=5601

# --- Dev / management UIs ---------------------------------------------------
FZL_ANGULAR_DEV_PORT=4200
FZL_PORTAINER_PORT_HTTP=9000
FZL_PORTAINER_PORT_TLS=9043

# --- Fakemail (host network, ports bind directly on host) -------------------
FZL_FAKEMAIL_WEB_PORT=5080
FZL_FAKEMAIL_MGMT_PORT=5081
FZL_FAKEMAIL_SMTP_PORT=8025

# --- Cloudflare Tunnel (exposes fzl-nginx as https://fzlbpms.com.br) --------
# Zero Trust dashboard (one.dash.cloudflare.com) -> Networks -> Tunnels ->
# fzlbpms-tunnel -> Configure -> copy the token from the "docker run ...
# --token <TOKEN>" install command shown there. Public-hostname routing
# (fzlbpms.com.br -> http://fzl-nginx:80) is configured in that same
# dashboard page, not in this repo. Required only to run fzl-cloudflared;
# other services don't need it, but docker compose still parses this file's
# ${...} refs for every command, so it must have SOME value even if unused.
FZL_CLOUDFLARE_TUNNEL_TOKEN=changeme
