# Theia build output — regenerated by `docker compose build fzl-theia`.
containers/fzl-theia/node_modules/
containers/fzl-theia/plugins/
containers/fzl-theia/lib/
containers/fzl-theia/src-gen/
containers/fzl-theia/gen-webpack*.js

# Vendored eclipse-theia/theia source (its own .git, ~4100 files) — cloned
# fresh into the image at build time for in-IDE reference browsing (see
# containers/fzl-theia/Dockerfile), never the actual build input, so never
# committed.
containers/fzl-theia/theia/

# Built .vsix output for fzl-theia-plugins, deployed into fzl-theia via a
# second THEIA_DEFAULT_PLUGINS local-dir source — regenerated by
# bin/theia/build-plugins.sh.
src-projects/fzl-theia-plugins-dist/
src-projects/fzl-theia-plugins/**/*.vsix

# docker-entrypoint.sh symlinks the vendored Theia reference source in here
# on every container start, through the ./workspaces bind mount — a dangling
# link on the host (the target only exists inside the container), never
# something to commit.
workspaces/theia-source

