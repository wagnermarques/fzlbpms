:org.apache.felix.configadmin.revision:=L"1"
felix.fileinstall.active.level="80"
felix.fileinstall.dir="/opt/karaf/deploy"
felix.fileinstall.filename="file:/opt/karaf/etc/org.apache.felix.fileinstall-deploy.cfg"
felix.fileinstall.log.level="3"
felix.fileinstall.poll="1000"
felix.fileinstall.start.level="80"
felix.fileinstall.tmpdir="/opt/karaf/data/generated-bundles"
service.bundleLocation="?"
service.factoryPid="org.apache.felix.fileinstall"
service.pid="org.apache.felix.fileinstall~deploy"
