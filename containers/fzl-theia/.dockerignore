# Never ship host-side build output into the image — the build stage produces
# its own. Copying a host node_modules would also mix glibc/musl native builds.
node_modules
plugins
lib
src-gen
gen-webpack.config.js
gen-webpack.node.config.js
.theia
certs

# Vendored eclipse-theia/theia reference checkout (own .git, own
# node_modules, thousands of files) — the build never reads from it, the
# Dockerfile clones its own copy fresh instead. Excluding it here keeps the
# build context small; without this, `COPY . .` would ship it into the build
# stage for nothing.
theia
