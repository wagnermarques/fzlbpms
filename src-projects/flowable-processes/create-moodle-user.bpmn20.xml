<?xml version="1.0" encoding="UTF-8"?>
<!--
  create-moodle-user

  Creates a single Keycloak + Moodle account (admin-initiated, e.g. from the
  fzlbpmsadmin-operated start form). Keycloak is the source of truth for
  identity; Moodle holds a synchronized replica (auth=oauth2) so the new
  person can log in — same dual-write pattern as moodle-create-turma, just
  for one person instead of a CSV of students.

  Flow:
    1. startEvent (start form) — username, firstName, lastName, email.
    2. prepareVariables (script) — URL-encodes firstName/lastName (Flowable's
       HTTP task sends ISO-8859-1 and would otherwise corrupt accents) and
       generates a random temporary Keycloak password.
    3. createKeycloakUser (HTTP) — POST to the Camel keycloak bundle's
       generic CRUD endpoint (already implemented, no new route needed):
       http://fzl-karaf-camel-integration:9090/fzlbpms/admin/users
       Body is a real Keycloak UserRepresentation. Keycloak returns 201 +
       empty body (no JSON to parse) — success is checked via the HTTP
       task's own ResponseStatusCode variable.
    4. checkKeycloakUserCreated (script) — fails loudly if not 201.
    5. createMoodleUser (HTTP) — POST to the Camel moodle bundle's new
       endpoint: http://fzl-karaf-camel-integration:9091/fzlbpms/moodle/users
       (auth is fixed server-side to "oauth2" by that route).
    6. checkMoodleUserCreated (script) — Moodle returns [{"id":N,...}] on
       success or {"exception":...} on failure; fails loudly on the latter.
    7. buildSummary (script) — human-readable result, including the
       temporary password so the admin can hand it off.
    8. reviewResults (user task, form) — the admin confirms; this is the
       task a "my pending tasks" lookup would find for a returning user.

  Charset trap: firstName/lastName are URL-encoded in the Groovy script
  (correct UTF-8 there on Java 11) and sent as pure ASCII; username/email
  are assumed ASCII and sent raw. Runs on flowable-ui 6.7.2 / Java 11 /
  Groovy 3.0.9 — no groovy-json, so JSON is parsed with Jackson ObjectMapper.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://fzlbpms.com.br/processes"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath">

  <process id="create-moodle-user" name="Criar usuário (Keycloak + Moodle)" isExecutable="true">

    <!-- 1. Start form -->
    <startEvent id="startCreateUserForm" name="Novo usuário">
      <extensionElements>
        <flowable:formProperty id="username" name="Username" type="string" required="true"/>
        <flowable:formProperty id="firstName" name="Nome" type="string" required="true"/>
        <flowable:formProperty id="lastName" name="Sobrenome" type="string" required="true"/>
        <flowable:formProperty id="email" name="E-mail" type="string" required="true"/>
      </extensionElements>
    </startEvent>
    <sequenceFlow id="toPrepare" sourceRef="startCreateUserForm" targetRef="prepareVariables"/>

    <!-- 2. URL-encode names + generate a temporary Keycloak password -->
    <scriptTask id="prepareVariables" name="Preparar variáveis" scriptFormat="groovy">
      <script><![CDATA[
        def enc = { v -> java.net.URLEncoder.encode((v ?: '').toString(), 'UTF-8') }
        // For the Moodle leg: pre-url-encoded, pure ASCII — the Camel bundle
        // forwards it verbatim into a form body that PHP/Moodle urldecodes.
        execution.setVariable('firstNameEnc', enc(firstName))
        execution.setVariable('lastNameEnc', enc(lastName))
        // For the Keycloak leg: kc-create-user is a raw JSON pass-through
        // with no decode step, so a url-encoded value (with its literal '%'
        // characters) fails Keycloak's name validation outright. Flowable's
        // HTTP task always re-encodes the outgoing body as ISO-8859-1
        // regardless of the declared charset — re-interpreting this string's
        // own UTF-8 bytes as ISO-8859-1 characters now means that later,
        // wrong re-encoding reconstructs the original UTF-8 bytes on the
        // wire, which Keycloak (reading the request as UTF-8) decodes back
        // to the correct text.
        def toWireSafe = { v -> new String((v ?: '').toString().getBytes('UTF-8'), 'ISO-8859-1') }
        execution.setVariable('firstNameKc', toWireSafe(firstName))
        execution.setVariable('lastNameKc', toWireSafe(lastName))
        execution.setVariable('tempPassword', UUID.randomUUID().toString().replace('-', '').substring(0, 12))
        // Who is operating this process (the logged-in Keycloak/oauth2-proxy
        // identity, forwarded by the start-bridge as a variable) — used to
        // assign reviewResults so a "my pending tasks" lookup finds it. Must
        // match oauth2-proxy's X-Auth-Request-User exactly — confirmed via
        // its access log to be the Keycloak user's EMAIL, not the bare
        // username. Defaults to the stack admin until more than one real
        // user exists.
        if (!execution.hasVariable('requestedBy') || !requestedBy) {
          execution.setVariable('requestedBy', 'fzlbpmsadmin@fzlbpms.local')
        }
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toCreateKcUser" sourceRef="prepareVariables" targetRef="createKeycloakUser"/>

    <!-- 3. Create the Keycloak user (existing generic CRUD endpoint) -->
    <serviceTask id="createKeycloakUser" name="Criar usuário no Keycloak" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://fzl-karaf-camel-integration:9090/fzlbpms/admin/users</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:string>Content-Type: application/json; charset=UTF-8</flowable:string></flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression>{"username":"${username}","email":"${email}","firstName":"${firstNameKc}","lastName":"${lastNameKc}","enabled":true,"emailVerified":true,"credentials":[{"type":"password","value":"${tempPassword}","temporary":true}]}</flowable:expression>
        </flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>kcUserResponse</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="toCheckKcUser" sourceRef="createKeycloakUser" targetRef="checkKeycloakUserCreated"/>

    <!-- 4. Keycloak returns 201 + empty body on success. Flowable's HTTP task
         (saveResponseParameters=true) exposes the status code as
         "<serviceTask id>ResponseStatusCode" — prefixed by the task's own id,
         NOT by responseVariableName. -->
    <scriptTask id="checkKeycloakUserCreated" name="Verificar criação no Keycloak" scriptFormat="groovy">
      <script><![CDATA[
        def status = execution.getVariable('createKeycloakUserResponseStatusCode')
        if (status == null || !(status.toString() ==~ /2\d\d/)) {
          throw new org.flowable.common.engine.api.FlowableException(
            "Falha ao criar usuário no Keycloak (status " + status + "): " + kcUserResponse)
        }
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toCreateMoodleUser" sourceRef="checkKeycloakUserCreated" targetRef="createMoodleUser"/>

    <!-- 5. Create the Moodle user (auth=oauth2, fixed server-side by the route) -->
    <serviceTask id="createMoodleUser" name="Criar usuário no Moodle" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://fzl-karaf-camel-integration:9091/fzlbpms/moodle/users</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:string>Content-Type: application/json; charset=UTF-8</flowable:string></flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression>{"username":"${username}","email":"${email}","firstname":"${firstNameEnc}","lastname":"${lastNameEnc}"}</flowable:expression>
        </flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>moodleUserResponse</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="toCheckMoodleUser" sourceRef="createMoodleUser" targetRef="checkMoodleUserCreated"/>

    <!-- 6. Moodle returns [{"id":N,...}] on success, {"exception":...} on failure -->
    <scriptTask id="checkMoodleUserCreated" name="Verificar criação no Moodle" scriptFormat="groovy">
      <script><![CDATA[
        def node = new com.fasterxml.jackson.databind.ObjectMapper().readTree(moodleUserResponse.toString())
        if (node == null || !node.isArray() || node.size() == 0 || node.get(0).get('id') == null) {
          throw new org.flowable.common.engine.api.FlowableException(
            "Falha ao criar usuário no Moodle: " + moodleUserResponse)
        }
        execution.setVariable('moodleUserId', node.get(0).get('id').asInt())
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toBuildSummary" sourceRef="checkMoodleUserCreated" targetRef="buildSummary"/>

    <!-- 7. Human-readable summary for the review form -->
    <scriptTask id="buildSummary" name="Montar resumo" scriptFormat="groovy">
      <script><![CDATA[
        def sb = new StringBuilder()
        sb.append("Usuário: ").append(username).append("\n")
        sb.append("Nome: ").append(firstName).append(" ").append(lastName).append("\n")
        sb.append("E-mail: ").append(email).append("\n")
        sb.append("Criado no Keycloak: sim\n")
        sb.append("Criado no Moodle (id): ").append(moodleUserId).append("\n")
        sb.append("Senha temporária (Keycloak, troca obrigatória no 1º login): ").append(tempPassword)
        execution.setVariable('resumo', sb.toString())
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toReview" sourceRef="buildSummary" targetRef="reviewResults"/>

    <!-- 8. Review form — operator confirms the result. Assigned to whoever
         started the process (see prepareVariables) so a task-inbox lookup
         by username finds it. -->
    <userTask id="reviewResults" name="Revisar resultado da criação do usuário" flowable:assignee="${requestedBy}">
      <extensionElements>
        <flowable:formProperty id="usernameOut" name="Usuário" type="string" expression="${username}" writable="false"/>
        <flowable:formProperty id="resumoOut" name="Resumo" type="string" expression="${resumo}" writable="false"/>
        <flowable:formProperty id="confirmacao" name="Confirmação" type="enum" required="true">
          <flowable:value id="ok" name="OK — usuário criado corretamente"/>
          <flowable:value id="revisar" name="Preciso revisar"/>
        </flowable:formProperty>
      </extensionElements>
    </userTask>
    <sequenceFlow id="toEnd" sourceRef="reviewResults" targetRef="endEvent"/>

    <endEvent id="endEvent" name="Fim"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_create-moodle-user">
    <bpmndi:BPMNPlane bpmnElement="create-moodle-user" id="BPMNPlane_create-moodle-user">
      <bpmndi:BPMNShape bpmnElement="startCreateUserForm" id="S_startCreateUserForm">
        <omgdc:Bounds height="30.0" width="30.0" x="60.0" y="163.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="prepareVariables" id="S_prepareVariables">
        <omgdc:Bounds height="80.0" width="100.0" x="140.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="createKeycloakUser" id="S_createKeycloakUser">
        <omgdc:Bounds height="80.0" width="100.0" x="280.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="checkKeycloakUserCreated" id="S_checkKeycloakUserCreated">
        <omgdc:Bounds height="80.0" width="100.0" x="420.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="createMoodleUser" id="S_createMoodleUser">
        <omgdc:Bounds height="80.0" width="100.0" x="560.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="checkMoodleUserCreated" id="S_checkMoodleUserCreated">
        <omgdc:Bounds height="80.0" width="100.0" x="700.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="buildSummary" id="S_buildSummary">
        <omgdc:Bounds height="80.0" width="100.0" x="840.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="reviewResults" id="S_reviewResults">
        <omgdc:Bounds height="80.0" width="100.0" x="980.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endEvent" id="S_endEvent">
        <omgdc:Bounds height="28.0" width="28.0" x="1130.0" y="164.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="toPrepare" id="E_toPrepare">
        <omgdi:waypoint x="90.0" y="178.0"/><omgdi:waypoint x="140.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCreateKcUser" id="E_toCreateKcUser">
        <omgdi:waypoint x="240.0" y="178.0"/><omgdi:waypoint x="280.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCheckKcUser" id="E_toCheckKcUser">
        <omgdi:waypoint x="380.0" y="178.0"/><omgdi:waypoint x="420.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCreateMoodleUser" id="E_toCreateMoodleUser">
        <omgdi:waypoint x="520.0" y="178.0"/><omgdi:waypoint x="560.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCheckMoodleUser" id="E_toCheckMoodleUser">
        <omgdi:waypoint x="660.0" y="178.0"/><omgdi:waypoint x="700.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toBuildSummary" id="E_toBuildSummary">
        <omgdi:waypoint x="800.0" y="178.0"/><omgdi:waypoint x="840.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toReview" id="E_toReview">
        <omgdi:waypoint x="940.0" y="178.0"/><omgdi:waypoint x="980.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toEnd" id="E_toEnd">
        <omgdi:waypoint x="1080.0" y="178.0"/><omgdi:waypoint x="1130.0" y="178.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
