<?xml version="1.0" encoding="UTF-8"?>
<!--
  create-organization

  Creates a Keycloak Organization (native Organizations feature, Keycloak
  26) plus its two default roles — admin-only action, enforced end-to-end
  by forwarding the caller's own bearer token through the process (see
  below), not by anything inside Flowable's own identity layer.

  Flow:
    1. startEvent (start form) — orgName, orgAlias. Also receives
       callerAuthHeader as a plain (non-form) variable, injected by the
       kc-provision-organization bridge in keycloak-admin-camel-context.xml
       — NOT something a human fills in.
    2. prepareVariables (script) — slugifies orgAlias (lowercase, ASCII,
       hyphen-separated), derives the two default role names
       (org-<alias>-dono / org-<alias>-membro), and wire-safe-encodes
       orgName for the Keycloak leg (see charset note below).
    3. createOrganization (HTTP) — POST to the Camel keycloak bundle's new
       endpoint: http://fzl-karaf-camel-integration:9090/fzlbpms/admin/organizations
       Requires kc-ensure-organizations-enabled to have run at least once
       (realm attribute). Body is a Keycloak OrganizationRepresentation.
    4. checkOrganizationCreated (script) — fails loudly if not 2xx.
    5/6. createRoleDono / checkRoleDonoCreated — POST .../fzlbpms/admin/roles
       for the "dono" (owner) role.
    7/8. createRoleMembro / checkRoleMembroCreated — same, for "membro".
    9. buildSummary (script) — human-readable result.
    10. endEvent.

  AUTHORIZATION: every one of these calls lands on a route gated by
  direct:kc-authorize-admin (requires the realm role 'admin'). Flowable
  itself has no identity of its own to present, so the bridge that starts
  this process captures the HUMAN caller's own bearer token (already
  validated as an admin there) and passes it through as the
  'callerAuthHeader' variable — every HTTP task below sends
  "Authorization: ${callerAuthHeader}". The token's short lifetime
  (minutes) comfortably covers this short, synchronous sequence of calls.

  Charset trap: Flowable's HTTP task always re-encodes the outgoing body as
  ISO-8859-1 regardless of the declared charset, corrupting accents.
  orgName is pre-converted in prepareVariables the same way
  create-moodle-user.bpmn20.xml handles firstName/lastName (reinterpret the
  UTF-8 bytes as ISO-8859-1 chars now, so Flowable's later wrong re-encoding
  reconstructs the original UTF-8 bytes on the wire). orgAlias is plain
  ASCII after slugifying, so it needs no such treatment.

  Runs on flowable-ui 6.7.2 / Java 11 / Groovy 3.0.9 — no groovy-json, JSON
  responses (none expected here — Keycloak returns 2xx + empty body on both
  of these calls) aren't parsed; only the HTTP task's own
  ResponseStatusCode variable is checked.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://fzlbpms.com.br/processes"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath">

  <process id="create-organization" name="Criar organização (Keycloak)" isExecutable="true">

    <!-- 1. Start form -->
    <startEvent id="startCreateOrganizationForm" name="Nova organização">
      <extensionElements>
        <flowable:formProperty id="orgName" name="Nome da organização" type="string" required="true"/>
        <flowable:formProperty id="orgAlias" name="Alias (identificador)" type="string" required="true"/>
      </extensionElements>
    </startEvent>
    <sequenceFlow id="toPrepare" sourceRef="startCreateOrganizationForm" targetRef="prepareVariables"/>

    <!-- 2. Slugify alias, derive default role names, wire-safe-encode orgName -->
    <scriptTask id="prepareVariables" name="Preparar variáveis" scriptFormat="groovy">
      <script><![CDATA[
        def slug = (orgAlias ?: '').toString().trim().toLowerCase()
          .replaceAll('[àáâãäå]', 'a').replaceAll('[èéêë]', 'e').replaceAll('[ìíîï]', 'i')
          .replaceAll('[òóôõö]', 'o').replaceAll('[ùúûü]', 'u').replaceAll('ç', 'c').replaceAll('ñ', 'n')
          .replaceAll('[^a-z0-9]+', '-').replaceAll('(^-+|-+$)', '')
        if (!slug) {
          throw new org.flowable.common.engine.api.FlowableException(
            "Alias da organização inválido (vazio após normalização): '" + orgAlias + "'")
        }
        execution.setVariable('orgAlias', slug)
        execution.setVariable('roleDono', 'org-' + slug + '-dono')
        execution.setVariable('roleMembro', 'org-' + slug + '-membro')

        // Keycloak leg: reinterpret the UTF-8 bytes as ISO-8859-1 chars now,
        // where the string is still correct UTF-8 on Java 11 — Flowable's
        // HTTP task re-encodes the body as ISO-8859-1 regardless of
        // Content-Type, which then reconstructs the original UTF-8 bytes
        // on the wire (see the file header note).
        def toWireSafe = { v -> new String((v ?: '').toString().getBytes('UTF-8'), 'ISO-8859-1') }
        execution.setVariable('orgNameKc', toWireSafe(orgName))
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toCreateOrganization" sourceRef="prepareVariables" targetRef="createOrganization"/>

    <!-- 3. Create the organization in Keycloak -->
    <serviceTask id="createOrganization" name="Criar organização no Keycloak" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://fzl-karaf-camel-integration:9090/fzlbpms/admin/organizations</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression>Content-Type: application/json; charset=UTF-8
Authorization: ${callerAuthHeader}</flowable:expression></flowable:field>
        <flowable:field name="requestBody">
          <!-- Keycloak rejects organization creation with no domains
               ("You must provide at least one domain", confirmed against
               this stack's own Keycloak 26). A placeholder, unverified
               domain under a non-routable TLD satisfies that requirement
               without implying any real domain ownership. -->
          <flowable:expression>{"name":"${orgNameKc}","alias":"${orgAlias}","domains":[{"name":"${orgAlias}.fzlbpms.local","verified":false}]}</flowable:expression>
        </flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>createOrgResponse</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="toCheckOrganization" sourceRef="createOrganization" targetRef="checkOrganizationCreated"/>

    <!-- 4. Keycloak returns 201 + empty body on success -->
    <scriptTask id="checkOrganizationCreated" name="Verificar criação da organização" scriptFormat="groovy">
      <script><![CDATA[
        def status = execution.getVariable('createOrganizationResponseStatusCode')
        if (status == null || !(status.toString() ==~ /2\d\d/)) {
          throw new org.flowable.common.engine.api.FlowableException(
            "Falha ao criar organização no Keycloak (status " + status + "): " + createOrgResponse)
        }
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toCreateRoleDono" sourceRef="checkOrganizationCreated" targetRef="createRoleDono"/>

    <!-- 5. Default role: dono (owner) -->
    <serviceTask id="createRoleDono" name="Criar papel 'dono'" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://fzl-karaf-camel-integration:9090/fzlbpms/admin/roles</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression>Content-Type: application/json; charset=UTF-8
Authorization: ${callerAuthHeader}</flowable:expression></flowable:field>
        <flowable:field name="requestBody">
          <!-- ASCII-only literal text — any accented character here hits
               the same ISO-8859-1 wire-reencoding corruption as orgName
               (see file header), but this literal never goes through
               prepareVariables' toWireSafe() since it's not a variable. -->
          <flowable:expression>{"name":"${roleDono}","description":"Organization owner role: ${orgAlias}"}</flowable:expression>
        </flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>createRoleDonoResponse</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="toCheckRoleDono" sourceRef="createRoleDono" targetRef="checkRoleDonoCreated"/>

    <!-- 6. -->
    <scriptTask id="checkRoleDonoCreated" name="Verificar papel 'dono'" scriptFormat="groovy">
      <script><![CDATA[
        def status = execution.getVariable('createRoleDonoResponseStatusCode')
        if (status == null || !(status.toString() ==~ /2\d\d/)) {
          throw new org.flowable.common.engine.api.FlowableException(
            "Falha ao criar o papel '" + roleDono + "' (status " + status + "): " + createRoleDonoResponse)
        }
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toCreateRoleMembro" sourceRef="checkRoleDonoCreated" targetRef="createRoleMembro"/>

    <!-- 7. Default role: membro (member) -->
    <serviceTask id="createRoleMembro" name="Criar papel 'membro'" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://fzl-karaf-camel-integration:9090/fzlbpms/admin/roles</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:expression>Content-Type: application/json; charset=UTF-8
Authorization: ${callerAuthHeader}</flowable:expression></flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression>{"name":"${roleMembro}","description":"Organization member role: ${orgAlias}"}</flowable:expression>
        </flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>createRoleMembroResponse</flowable:string></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="toCheckRoleMembro" sourceRef="createRoleMembro" targetRef="checkRoleMembroCreated"/>

    <!-- 8. -->
    <scriptTask id="checkRoleMembroCreated" name="Verificar papel 'membro'" scriptFormat="groovy">
      <script><![CDATA[
        def status = execution.getVariable('createRoleMembroResponseStatusCode')
        if (status == null || !(status.toString() ==~ /2\d\d/)) {
          throw new org.flowable.common.engine.api.FlowableException(
            "Falha ao criar o papel '" + roleMembro + "' (status " + status + "): " + createRoleMembroResponse)
        }
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toBuildSummary" sourceRef="checkRoleMembroCreated" targetRef="buildSummary"/>

    <!-- 9. Human-readable summary -->
    <scriptTask id="buildSummary" name="Montar resumo" scriptFormat="groovy">
      <script><![CDATA[
        def sb = new StringBuilder()
        sb.append("Organização: ").append(orgName).append(" (alias: ").append(orgAlias).append(")\n")
        sb.append("Papéis padrão criados: ").append(roleDono).append(", ").append(roleMembro)
        execution.setVariable('resumo', sb.toString())
      ]]></script>
    </scriptTask>
    <sequenceFlow id="toEnd" sourceRef="buildSummary" targetRef="endEvent"/>

    <endEvent id="endEvent" name="Fim"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_create-organization">
    <bpmndi:BPMNPlane bpmnElement="create-organization" id="BPMNPlane_create-organization">
      <bpmndi:BPMNShape bpmnElement="startCreateOrganizationForm" id="S_startCreateOrganizationForm">
        <omgdc:Bounds height="30.0" width="30.0" x="60.0" y="163.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="prepareVariables" id="S_prepareVariables">
        <omgdc:Bounds height="80.0" width="100.0" x="140.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="createOrganization" id="S_createOrganization">
        <omgdc:Bounds height="80.0" width="100.0" x="280.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="checkOrganizationCreated" id="S_checkOrganizationCreated">
        <omgdc:Bounds height="80.0" width="100.0" x="420.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="createRoleDono" id="S_createRoleDono">
        <omgdc:Bounds height="80.0" width="100.0" x="560.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="checkRoleDonoCreated" id="S_checkRoleDonoCreated">
        <omgdc:Bounds height="80.0" width="100.0" x="700.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="createRoleMembro" id="S_createRoleMembro">
        <omgdc:Bounds height="80.0" width="100.0" x="840.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="checkRoleMembroCreated" id="S_checkRoleMembroCreated">
        <omgdc:Bounds height="80.0" width="100.0" x="980.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="buildSummary" id="S_buildSummary">
        <omgdc:Bounds height="80.0" width="100.0" x="1120.0" y="138.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endEvent" id="S_endEvent">
        <omgdc:Bounds height="28.0" width="28.0" x="1270.0" y="164.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="toPrepare" id="E_toPrepare">
        <omgdi:waypoint x="90.0" y="178.0"/><omgdi:waypoint x="140.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCreateOrganization" id="E_toCreateOrganization">
        <omgdi:waypoint x="240.0" y="178.0"/><omgdi:waypoint x="280.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCheckOrganization" id="E_toCheckOrganization">
        <omgdi:waypoint x="380.0" y="178.0"/><omgdi:waypoint x="420.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCreateRoleDono" id="E_toCreateRoleDono">
        <omgdi:waypoint x="520.0" y="178.0"/><omgdi:waypoint x="560.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCheckRoleDono" id="E_toCheckRoleDono">
        <omgdi:waypoint x="660.0" y="178.0"/><omgdi:waypoint x="700.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCreateRoleMembro" id="E_toCreateRoleMembro">
        <omgdi:waypoint x="800.0" y="178.0"/><omgdi:waypoint x="840.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toCheckRoleMembro" id="E_toCheckRoleMembro">
        <omgdi:waypoint x="940.0" y="178.0"/><omgdi:waypoint x="980.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toBuildSummary" id="E_toBuildSummary">
        <omgdi:waypoint x="1080.0" y="178.0"/><omgdi:waypoint x="1120.0" y="178.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toEnd" id="E_toEnd">
        <omgdi:waypoint x="1220.0" y="178.0"/><omgdi:waypoint x="1270.0" y="178.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

